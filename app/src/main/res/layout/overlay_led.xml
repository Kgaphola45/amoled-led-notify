<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <!-- Subtle Drag feedback ring shown while user touches/drags dot -->
    <View
        android:id="@+id/dragRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="invisible" />

    <!-- Pure Solid LED Dot (No glow, crisp solid color) -->
    <View
        android:id="@+id/ledDot"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:background="@drawable/led_circle" />

</FrameLayout>
