<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Color Picker"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Adjust RGB sliders, enter a HEX code, or choose an AMOLED neon preset:"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!-- Preview & HEX Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewColorPreview"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#00FF00" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEX Color Code"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etHexCode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="#2C2C2C"
                    android:digits="#0123456789ABCDEFabcdef"
                    android:hint="#00FF00"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="7"
                    android:paddingHorizontal="12dp"
                    android:text="#00FF00"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Red Slider -->
        <TextView
            android:id="@+id/tvRedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Red: 0"
            android:textColor="#FF5252"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="255"
            android:progress="0"
            android:progressTint="#FF5252"
            android:thumbTint="#FF5252" />

        <!-- Green Slider -->
        <TextView
            android:id="@+id/tvGreenLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Green: 255"
            android:textColor="#69F0AE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="255"
            android:progress="255"
            android:progressTint="#69F0AE"
            android:thumbTint="#69F0AE" />

        <!-- Blue Slider -->
        <TextView
            android:id="@+id/tvBlueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Blue: 0"
            android:textColor="#448AFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="255"
            android:progress="0"
            android:progressTint="#448AFF"
            android:thumbTint="#448AFF" />

        <!-- Quick Neon Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AMOLED Neon Presets"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutNeonPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelCustomColor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="#333333"
                android:text="Cancel"
                android:textColor="#AAAAAA" />

            <Button
                android:id="@+id/btnApplyCustomColor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="#5E35B1"
                android:text="Apply Color"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
